---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
---
<Base title="Privacy Policy | Havok Restoration of Central PA" description="How Havok Restoration of Central PA collects and uses information submitted through this website." noindex>
  <section class="page-hero"><div class="container"><h1>Privacy policy</h1></div></section>
  <section class="section section--white"><div class="container prose">
    <p>Havok Restoration of Central PA ("we") collects the information you submit through our contact forms (name, phone, email, address and details about your property loss) solely to respond to your request and provide restoration services. We do not sell your information.</p>
    <p>We may use standard analytics tools that collect anonymous usage data such as pages visited and device type. Our contact form may be processed by a third-party form service. Calls to our phone number may be recorded for quality and training.</p>
    <p>To request deletion of your information, email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    <p>Last updated: September 2026.</p>
  </div></section>
</Base>

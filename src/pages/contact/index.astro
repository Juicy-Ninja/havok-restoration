---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ContactForm from '../../components/ContactForm.astro';
import { site, areas } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';
---
<Base
  title="Contact Havok Restoration of Central PA | 24/7 Emergency Line (814) 809-9833"
  description="Call (814) 809-9833 any hour for emergency restoration in Johnstown and Central PA, or request a free estimate online. Locally owned, insurance-approved."
  schema={[breadcrumbSchema([{ name: 'Home', url: site.url + '/' }, { name: 'Contact', url: site.url + '/contact/' }])]}
>
  <section class="page-hero">
    <div class="container">
      <ol class="crumbs"><li><a href="/">Home</a></li><li>Contact</li></ol>
      <p class="eyebrow">We answer. Every time.</p>
      <h1>Talk to us</h1>
      <p class="lead">Emergencies get a live person and a crew on the road. Everything else gets a straight answer from someone who has done this hundreds of times.</p>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container contact">
      <div class="contact__info reveal">
        <a href={site.phoneHref} class="contact__phone">
          <Icon name="phone" size={30} />
          <span><small>24/7 emergency line</small><strong>{site.phone}</strong></span>
        </a>
        <dl class="contact__list">
          <div><dt><Icon name="mail" size={18} /> Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt><Icon name="pin" size={18} /> Based in</dt><dd>{site.address.street ? `${site.address.street}, ` : ''}{site.address.city}, {site.address.region} {site.address.postal}</dd></div>
          <div><dt><Icon name="clock" size={18} /> Hours</dt><dd>Emergency response 24 hours a day, 7 days a week, 365 days a year. Office hours Mon–Fri 8am–5pm for estimates and claim questions.</dd></div>
          <div><dt><Icon name="truck" size={18} /> Service area</dt><dd>{site.serviceRadiusMiles}-mile radius of Johnstown including {areas.map((a) => a.name).join(', ')} and surrounding communities.</dd></div>
        </dl>
        <div class="contact__map">
          <iframe title="Havok Restoration of Central PA service area map centered on Johnstown, Pennsylvania" src="https://www.google.com/maps?q=Johnstown,+PA&z=9&output=embed" width="100%" height="300" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 1000px) { .contact { grid-template-columns: 1fr 1.1fr; gap: 4rem; } }
  .contact__phone { display: flex; align-items: center; gap: 1rem; background: var(--navy-800); color: var(--white); padding: 1.25rem 1.5rem; border-radius: var(--radius); text-decoration: none; margin-bottom: 1.5rem; }
  .contact__phone svg { color: var(--orange-500); }
  .contact__phone small { display: block; text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.75rem; color: var(--amber-400); }
  .contact__phone strong { font-family: var(--font-display); font-size: 2rem; line-height: 1; }
  .contact__list { margin: 0; display: grid; gap: 1rem; }
  .contact__list div { background: var(--white); border: 1px solid var(--sand-200); border-radius: var(--radius-sm); padding: 1rem 1.2rem; }
  .contact__list dt { display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; color: var(--orange-600); font-size: 0.9rem; margin-bottom: 0.3rem; }
  .contact__list dd { margin: 0; color: var(--ink-700); font-size: 0.95rem; }
  .contact__map { margin-top: 1.5rem; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-sm); }
</style>

---
import Base from '../../../layouts/Base.astro';
import BlogCard from '../../../components/BlogCard.astro';
import CTABand from '../../../components/CTABand.astro';
import { getCollection } from 'astro:content';
import { site } from '../../../data/site';
import { breadcrumbSchema } from '../../../lib/schema';

const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
export async function getStaticPaths() {
  const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const cats = [...new Set(posts.map((p) => p.data.category))];
  return cats.map((c) => ({ params: { category: slug(c) }, props: { category: c, posts: posts.filter((p) => p.data.category === c).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()) } }));
}
const { category, posts } = Astro.props;
const all = await getCollection('blog', ({ data }) => !data.draft);
const categories = [...new Set(all.map((p) => p.data.category))];
---
<Base
  title={`${category} Articles | Havok Restoration of Central PA Blog`}
  description={`${category} advice for Central Pennsylvania homeowners from Johnstown's locally owned restoration company.`}
  schema={[breadcrumbSchema([{ name: 'Home', url: site.url + '/' }, { name: 'Blog', url: site.url + '/blog/' }, { name: category, url: `${site.url}/blog/category/${slugify(category)}/` }])]}
>
  <section class="page-hero">
    <div class="container">
      <ol class="crumbs"><li><a href="/">Home</a></li><li><a href="/blog/">Blog</a></li><li>{category}</li></ol>
      <p class="eyebrow">Category</p>
      <h1>{category}</h1>
      <nav class="cats" aria-label="Blog categories">
        <a href="/blog/" class="pill">All</a>
        {categories.map((c) => <a href={`/blog/category/${slugify(c)}/`} class={`pill ${c === category ? 'is-on' : ''}`}>{c}</a>)}
      </nav>
    </div>
  </section>
  <section class="section section--sand"><div class="container grid grid-3">{posts.map((p) => <BlogCard post={p} />)}</div></section>
  <CTABand />
</Base>
<style>
  .cats { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .cats .pill { text-decoration: none; background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15); color: var(--white); }
  .cats .pill:hover, .cats .pill.is-on { background: var(--orange-500); border-color: var(--orange-500); }
</style>

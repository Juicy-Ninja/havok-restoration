---
import { site, services } from '../data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const active = (p: string) => (path === p || (p !== '/' && path.startsWith(p)) ? 'is-active' : '');
---
<div class="topbar">
  <div class="container topbar__inner">
    <span class="pill pill--live topbar__live">Crews available now · 24/7 emergency response</span>
    <span class="topbar__area">Serving Johnstown, Altoona, State College, Indiana, Greensburg & all of Central PA</span>
  </div>
</div>
<header class="header" id="top">
  <div class="container header__inner">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="44" height="44"><path d="M24 4 6 14v20l18 10 18-10V14z" fill="#f26522"/><path d="M24 12 12 18.5v11L24 36l12-6.5v-11z" fill="#0b1f3a"/><path d="M18 22h4v-4h4v4h4v4h-4v4h-4v-4h-4z" fill="#fff"/></svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">Havok Restoration</span>
        <span class="brand__sub">of Central PA</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        <li class="has-menu">
          <a href="/services/" class={active('/services/')}>Services <Icon name="chevron" size={16} /></a>
          <div class="menu">
            <div class="menu__grid">
              {services.map((s) => (
                <a href={`/services/${s.slug}/`} class="menu__item">
                  <Icon name={s.icon} size={20} />
                  <span><strong>{s.name}</strong><small>{s.short}</small></span>
                </a>
              ))}
            </div>
          </div>
        </li>
        <li><a href="/service-areas/" class={active('/service-areas/')}>Service Areas</a></li>
        <li><a href="/insurance-claims/" class={active('/insurance-claims/')}>Insurance Help</a></li>
        <li><a href="/about/" class={active('/about/')}>About</a></li>
        <li><a href="/blog/" class={active('/blog/')}>Blog</a></li>
        <li><a href="/contact/" class={active('/contact/')}>Contact</a></li>
      </ul>
    </nav>

    <a href={site.phoneHref} class="btn btn-primary header__call"><Icon name="phone" /> {site.phone}</a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <Icon name="menu" size={28} />
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <div class="mobile-nav__head">
      <strong>Menu</strong>
      <button class="menu-close" aria-label="Close menu"><Icon name="x" size={26} /></button>
    </div>
    <a href={site.phoneHref} class="btn btn-primary btn-lg mobile-nav__call"><Icon name="phone" /> Call {site.phone}</a>
    <p class="mobile-nav__label">Services</p>
    <ul>
      {services.map((s) => <li><a href={`/services/${s.slug}/`}><Icon name={s.icon} size={18} /> {s.name}</a></li>)}
    </ul>
    <p class="mobile-nav__label">Company</p>
    <ul>
      <li><a href="/service-areas/"><Icon name="pin" size={18} /> Service Areas</a></li>
      <li><a href="/insurance-claims/"><Icon name="file" size={18} /> Insurance Help</a></li>
      <li><a href="/financing/"><Icon name="dollar" size={18} /> Financing</a></li>
      <li><a href="/about/"><Icon name="users" size={18} /> About Havok</a></li>
      <li><a href="/blog/"><Icon name="file" size={18} /> Blog</a></li>
      <li><a href="/contact/"><Icon name="mail" size={18} /> Contact</a></li>
    </ul>
  </div>
</header>

<a href={site.phoneHref} class="callbar" aria-label={`Call ${site.phone} now`}>
  <Icon name="phone" /> <span>Emergency? Call now · {site.phone}</span>
</a>

<style>
  .topbar { background: var(--navy-900); color: #b9c6d8; font-size: 0.82rem; }
  .topbar__inner { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-block: 0.4rem; }
  .topbar__live { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.12); color: #e7edf5; font-size: 0.78rem; }
  .topbar__area { display: none; }
  @media (min-width: 900px) { .topbar__area { display: inline; } }

  .header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,0.92); backdrop-filter: saturate(160%) blur(10px); border-bottom: 1px solid var(--sand-200); }
  .header__inner { display: flex; align-items: center; gap: 1.5rem; height: 78px; }
  .brand { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--navy-800); margin-right: auto; }
  .brand__mark svg { display: block; }
  .brand__text { display: flex; flex-direction: column; line-height: 1; }
  .brand__name { font-family: var(--font-display); font-weight: 800; font-size: 1.55rem; text-transform: uppercase; letter-spacing: 0.01em; }
  .brand__sub { font-size: 0.78rem; font-weight: 600; color: var(--orange-600); letter-spacing: 0.12em; text-transform: uppercase; margin-top: 3px; }

  .nav { display: none; }
  .nav ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav a { display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.55rem 0.8rem; border-radius: 8px; font-weight: 600; color: var(--navy-800); text-decoration: none; font-size: 0.98rem; }
  .nav a:hover, .nav a.is-active { background: var(--sand-100); color: var(--navy-800); }
  .has-menu { position: relative; }
  .menu { position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(8px); width: min(760px, 92vw); background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow-lg); padding: 1rem; opacity: 0; visibility: hidden; transition: opacity 0.15s ease, transform 0.15s ease; border: 1px solid var(--sand-200); }
  .has-menu:hover .menu, .has-menu:focus-within .menu { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
  .menu__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.25rem; }
  .menu__item { display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.7rem 0.75rem; border-radius: 10px; text-decoration: none; color: var(--navy-800); }
  .menu__item:hover { background: var(--sand-100); }
  .menu__item svg { color: var(--orange-500); flex-shrink: 0; margin-top: 3px; }
  .menu__item strong { display: block; font-size: 0.95rem; line-height: 1.2; }
  .menu__item small { display: block; color: var(--ink-500); font-size: 0.78rem; line-height: 1.35; margin-top: 3px; }

  .header__call { display: none; }
  .menu-toggle { display: inline-flex; background: none; border: 0; padding: 0.4rem; color: var(--navy-800); cursor: pointer; }
  @media (min-width: 1080px) {
    .nav { display: block; }
    .header__call { display: inline-flex; }
    .menu-toggle { display: none; }
  }

  .mobile-nav { position: fixed; inset: 0; z-index: 60; background: var(--white); overflow-y: auto; padding: 1rem var(--gutter) 3rem; }
  .mobile-nav[hidden] { display: none; }
  .mobile-nav__head { display: flex; justify-content: space-between; align-items: center; font-family: var(--font-display); font-size: 1.4rem; text-transform: uppercase; margin-bottom: 1rem; }
  .menu-close { background: none; border: 0; padding: 0.4rem; color: var(--navy-800); cursor: pointer; }
  .mobile-nav__call { width: 100%; margin-bottom: 1.25rem; }
  .mobile-nav__label { font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.12em; color: var(--orange-600); font-weight: 700; margin: 1.25rem 0 0.4rem; font-size: 0.85rem; }
  .mobile-nav ul { list-style: none; margin: 0; padding: 0; }
  .mobile-nav li a { display: flex; align-items: center; gap: 0.75rem; padding: 0.8rem 0.25rem; border-bottom: 1px solid var(--sand-200); text-decoration: none; color: var(--navy-800); font-weight: 600; }
  .mobile-nav li a svg { color: var(--orange-500); }

  .callbar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 40; display: flex; justify-content: center; align-items: center; gap: 0.6rem; background: var(--orange-500); color: var(--white); font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; text-transform: uppercase; letter-spacing: 0.03em; text-decoration: none; padding: 1rem; box-shadow: 0 -6px 20px rgba(7,20,40,0.2); }
  @media (min-width: 900px) { .callbar { display: none; } }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const closeBtn = document.querySelector('.menu-close');
  const panel = document.getElementById('mobile-nav');
  const open = (v: boolean) => {
    if (!panel || !toggle) return;
    panel.hidden = !v;
    toggle.setAttribute('aria-expanded', String(v));
    document.body.style.overflow = v ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => open(panel!.hidden));
  closeBtn?.addEventListener('click', () => open(false));
  panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => open(false)));
</script>

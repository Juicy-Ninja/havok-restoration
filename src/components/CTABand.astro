---
import { site } from '../data/site';
import Icon from './Icon.astro';
interface Props { title?: string; body?: string }
const { title = 'Water still running? Smoke still in the air? Call now.', body = 'You do not need to have it figured out. Tell us what happened and we will take it from there, including the call to your insurance company.' } = Astro.props;
---
<section class="cta">
  <div class="container cta__inner reveal">
    <div>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <div class="cta__actions">
      <a href={site.phoneHref} class="btn btn-light btn-lg"><Icon name="phone" /> {site.phone}</a>
      <a href="/contact/" class="btn btn-outline cta__secondary">Request a free estimate</a>
    </div>
  </div>
</section>

<style>
  .cta { background: linear-gradient(120deg, var(--orange-600), var(--orange-500) 60%, #ff8a4c); color: var(--white); padding-block: clamp(3rem, 6vw, 4.5rem); }
  .cta__inner { display: grid; gap: 1.5rem; align-items: center; }
  @media (min-width: 900px) { .cta__inner { grid-template-columns: 1.4fr 1fr; } .cta__actions { justify-self: end; } }
  .cta h2 { color: var(--white); margin-bottom: 0.4rem; }
  .cta p { margin: 0; max-width: 60ch; opacity: 0.95; font-size: 1.1rem; }
  .cta__actions { display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start; }
  .cta__secondary { border-color: var(--white); color: var(--white); }
  .cta__secondary:hover { background: var(--white); color: var(--orange-600); }
</style>
